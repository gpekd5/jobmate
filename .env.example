DB_NAME=jobmate
DB_USER=jobmate
DB_PASSWORD=change_me_for_local
DB_ROOT_PASSWORD=change_me_root_for_local
DB_PORT=3307

# External AI stays disabled until explicitly configured and consented in the app.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Verify the chosen model's current USD / 1M token prices before enabling AI.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
AI_BUDGET_USD=5
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_MAX_INPUT_BYTES=24000
OPENAI_TIMEOUT_SECONDS=30
# Set an absolute private directory outside the repository / public web roots.
# JOBMATE_DOCUMENTS_PATH=/absolute/private/jobmate-documents
